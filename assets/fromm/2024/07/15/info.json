{
  "date": "2024-07-15",
  "messages": [
    {
      "type": "hayeon",
      "ko": "저번에",
      "en": "The other day,"
    },
    {
      "type": "hayeon",
      "ko": "내가 숙소좀",
      "en": "I got back to the dorm"
    },
    {
      "type": "hayeon",
      "ko": "일찍 들어와서",
      "en": "a little earlier than usual,"
    },
    {
      "type": "hayeon",
      "ko": "아무도 없었을때가 있었단말이야",
      "en": "and no one else was home."
    },
    {
      "type": "hayeon",
      "ko": "근데 우리방에 무드등이 켜져있길래",
      "en": "But the mood light in our room was on,"
    },
    {
      "type": "hayeon",
      "ko": "당연히 누가 있겠지 생각하고",
      "en": "so I naturally thought someone was inside."
    },
    {
      "type": "hayeon",
      "ko": "거실에 있었는데",
      "en": "I was sitting in the living room,"
    },
    {
      "type": "hayeon",
      "ko": "우리방 문이 활짝열려있는데",
      "en": "and our bedroom door was wide open."
    },
    {
      "type": "hayeon",
      "ko": "그 빛때문에 생기는 그림자가",
      "en": "Because of the light,"
    },
    {
      "type": "hayeon",
      "ko": "계속 지나다니는겨",
      "en": "there was a shadow that kept passing by."
    },
    {
      "type": "hayeon",
      "ko": "그래서",
      "en": "So"
    },
    {
      "type": "hayeon",
      "ko": "난 그냥 시온언니가",
      "en": "I just thought,"
    },
    {
      "type": "hayeon",
      "ko": "뭐 하고있나보다",
      "en": "\"Shion unnie must be doing something.\""
    },
    {
      "type": "hayeon",
      "ko": "생각하고",
      "en": "That's what I thought,"
    },
    {
      "type": "hayeon",
      "ko": "좀 이따 방 들어갔는데",
      "en": "then a little while later I went into the room..."
    },
    {
      "type": "hayeon",
      "ko": "아무도 없었음",
      "en": "and no one was there."
    },
    {
      "type": "hayeon",
      "ko": "진짜 뭔가 시온언니가 평소하는",
      "en": "It really looked exactly like"
    },
    {
      "type": "hayeon",
      "ko": "루틴의 움직임이였는데",
      "en": "the way Shion unnie normally moves during her usual routine."
    },
    {
      "type": "hayeon",
      "ko": "무서워서 유빈언니 방갔어",
      "en": "I got so scared that I went to Yubin unnie's room."
    },
    {
      "type": "hayeon",
      "ko": "매니저님도 없고",
      "en": "Even our manager wasn't there."
    },
    {
      "type": "hayeon",
      "ko": "완전 혼자였다니까",
      "en": "I was completely alone."
    },
    {
      "type": "hayeon",
      "ko": "얼마나 무서웠겠어",
      "en": "Do you know how scared I was?"
    },
    {
      "type": "hayeon",
      "ko": "이 아가가 혼자",
      "en": "This little baby was all by herself."
    }
  ]
}