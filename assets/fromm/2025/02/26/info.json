    },
    {
      "type": "hayeon",
      "ko": "난 어릴때부터",
      "en": "Ever since I was little,"
    },
    {
      "type": "hayeon",
      "ko": "나 억울할때만",
      "en": "I only cry when I feel wronged."
    },
    {
      "type": "hayeon",
      "ko": "눈물나",
      "en": "That's when tears come out."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅌㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㄹㅌㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "오빠랑 싸우고",
      "en": "Like after fighting with my brother,"
    },
    {
      "type": "hayeon",
      "ko": "엄마한테 해명할때라던지",
      "en": "or when I'm trying to explain myself to my mom."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "fan",
      "ko": "슬픈거봐더 안울어?",
      "en": "You don't cry even when watching something sad?"
    },
        {
      "type": "hayeon",
      "ko": "울어야겠다 이거 진짜 이입해서 봐야된다",
      "en": "If I really want to cry, I have to completely immerse myself in it."
    },
    {
      "type": "hayeon",
      "ko": "하는거는",
      "en": "When I do that,"
    },
    {
      "type": "hayeon",
      "ko": "울어",
      "en": "I cry."
    },
    {
      "type": "hayeon",
      "ko": "근데 그냥 생각없이 보면",
      "en": "But if I'm just watching without really thinking about it,"
    },
    {
      "type": "hayeon",
      "ko": "눈물 안나",
      "en": "I don't cry."
    },
    {
      "type": "hayeon",
      "ko": "나 울리고싶은거야?",
      "en": "Are you trying to make me cry?"
    },
    {
      "type": "hayeon",
      "ko": "ㅋㅋㅋㄹㅋㅋㅋㅋ",
      "en": "ㅋㅋㅋㄹㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "Y/n위해선 울수있지~",
      "en": "I could cry for Y/n though~"
    },
    {
      "type": "hayeon",
      "ko": "아 서울콘에서?",
      "en": "Oh, at the Seoul concert?"
    },
    {
      "type": "hayeon",
      "ko": "너무 공개적이잖아",
      "en": "That's way too public."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "fan",
      "ko": "비공개적으로만 우는 거야??",
      "en": "So you only cry in private??"
    },
    {
      "type": "hayeon",
      "ko": "웅 마음속으로",
      "en": "Yep, only inside my heart."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "fan",
      "ko": "너 영화 보고 잔다고 하던거 진짜 보고 잤어?",
      "en": "You said you were going to watch a movie before bed. Did you actually watch one?"
    },
    {
      "type": "hayeon",
      "ko": "ㅌㄹㅋㅋㄹㅋㄹㄹㅋㄹㅋ",
      "en": "ㅌㄹㅋㅋㄹㅋㄹㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "바로잠듬",
      "en": "I fell asleep immediately."
    },
    {
      "type": "hayeon",
      "ko": "영화 찾다가",
      "en": "I was looking for a movie,"
    },
    {
      "type": "hayeon",
      "ko": "잠들었어",
      "en": "then I fell asleep."
    },
    {
      "type": "hayeon",
      "ko": "피곤했나봨ㅋㅋ",
      "en": "I guess I was really tiredㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "미국 다녀와서",
      "en": "Ever since I came back from the U.S.,"
    },
    {
      "type": "hayeon",
      "ko": "잠을 잘자",
      "en": "I've been sleeping really well."
    },
    {
      "type": "hayeon",
      "ko": "오늘 날이 너무좋다",
      "en": "The weather is so nice today."
    },
    {
      "type": "hayeon",
      "ko": "이럴때 산책도 하구",
      "en": "It's the perfect day for a walk,"
    },
    {
      "type": "hayeon",
      "ko": "또이렇게",
      "en": "and just like that,"
    },
    {
      "type": "hayeon",
      "ko": "봄이 오네요",
      "en": "spring is arriving."
    },
    {
      "type": "hayeon",
      "ko": "허허",
      "en": "Hehe."
    },
    {
      "type": "hayeon",
      "ko": "2025봄을",
      "en": "I'm happy"
    },
    {
      "type": "hayeon",
      "ko": "같이 보낼수 있어서",
      "en": "that we get to spend"
    },
    {
      "type": "hayeon",
      "ko": "좋다",
      "en": "the spring of 2025 together."
    },
    {
      "type": "hayeon",
      "ko": "내년도",
      "en": "Next year,"
    },
    {
      "type": "hayeon",
      "ko": "같이 보내고",
      "en": "let's spend it together too,"
    },
    {
      "type": "hayeon",
      "ko": "계속",
      "en": "and"
    },
    {
      "type": "hayeon",
      "ko": "같이 보내야지",
      "en": "keep spending every year together."
    },
    {
      "type": "hayeon",
      "ko": "내가 성인되면",
      "en": "When I become an adult,"
    },
    {
      "type": "hayeon",
      "ko": "드라이브 싹~~",
      "en": "we'll go for a nice drive~~"
    },
    {
      "type": "hayeon",
      "ko": "하연 차 뽑았다 널 데리러가",
      "en": "\"Hayeon got a car—I'm coming to pick you up.\""
    },
    {
      "type": "hayeon",
      "ko": "내가 무리할게",
      "en": "I'll make it happen."
    },
    {
      "type": "hayeon",
      "ko": "나만 믿어",
      "en": "Just trust me."
    },
    {
      "type": "hayeon",
      "ko": "사실 너무 미래고",
      "en": "Although that's still way off in the future."
