      "ko": "막 미치겠지 막",
      "en": "You're probably going crazy missing me."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㅋㅋ",
      "en": "ㅋㄹㅋㄹㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "나도",
      "en": "Me too."
    },
    {
      "type": "hayeon",
      "ko": "그래서 왔잖아 ㅋ",
      "en": "That's why I came byㅋ"
    },
    {
      "type": "hayeon",
      "ko": "내가",
      "en": "I'll"
    },
    {
      "type": "hayeon",
      "ko": "오늘을 힘차게 보낼 힘을 줄게",
      "en": "give you the energy to get through today."
