    {
      "type": "hayeon",
      "image": "image-01.PNG"
    },
    {
      "type": "hayeon",
      "ko": "쏘 큐트",
      "en": "So cute."
    },
    {
      "type": "hayeon",
      "ko": "보고 힘내",
      "en": "Look at it and cheer up."
    },
    {
      "type": "fan",
      "ko": "네일 새로 했어?",
