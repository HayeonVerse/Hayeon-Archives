    },
    {
      "type": "hayeon",
      "ko": "아무거나 입고와.",
      "en": "Just wear whatever you want."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㄹㅋㄹㅋㅋㅋ",
      "en": "ㅋㄹㅋㄹㄹㅋㄹㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "나 서울콘 올백 의지가 다시 타오르고있는데 어쩌지",
