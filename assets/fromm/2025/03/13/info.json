    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "내가 양보할게",
