    {
      "type": "hayeon",
      "ko": "할게",
      "en": "whenever I feel like it during promotions."
    },
    {
      "type": "hayeon",
      "ko": "서울콘땐",
      "en": "For the Seoul concert,"
    },
    {
      "type": "hayeon",
      "ko": "알잘딱",
      "en": "I'll figure it out properly."
    },
    {
      "type": "hayeon",
      "ko": "해볼게",
      "en": "I'll make it work."
