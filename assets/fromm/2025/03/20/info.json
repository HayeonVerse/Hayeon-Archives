{
  "date": "2025-03-20",
  "messages": [
    {
      "type": "hayeon",
      "ko": "모해?",
      "en": "What are you doing?"
    },
    {
      "type": "hayeon",
      "ko": "자기전에 잠깐 들렸어",
      "en": "I stopped by for a bit before going to sleep."
    },
    {
      "type": "hayeon",
      "ko": "보고싶어서",
      "en": "Because I missed you."
    },
    {
      "type": "hayeon",
      "ko": "요즘 날씨 인상많이 안좋더라",
      "en": "The weather hasn't been very nice lately."
    },
    {
      "type": "hayeon",
      "ko": "감기 조심하고",
      "en": "Be careful not to catch a cold,"
    },
    {
      "type": "hayeon",
      "ko": "몸조심하고",
      "en": "and take care of yourself."
    },
    {
      "type": "hayeon",
      "ko": "내가 프롬에 사진 보내주고싶은데",
      "en": "I want to send you photos on Fromm,"
    },
    {
      "type": "hayeon",
      "ko": "이쁜 사진들도 많은데",
      "en": "and I have so many pretty ones,"
    },
    {
      "type": "hayeon",
      "ko": "아직 보낼수 없는것들이",
      "en": "but there are still so many"
    },
    {
      "type": "hayeon",
      "ko": "너무 많아서",
      "en": "that I can't share yet."
    },
    {
      "type": "hayeon",
      "ko": "너무 아쉬워…",
      "en": "It's such a shame..."
    },
    {
      "type": "hayeon",
      "ko": "그리고 진짜",
      "en": "And seriously,"
    },
    {
      "type": "hayeon",
      "ko": "깜짝 놀랄일들",
      "en": "there are going to be"
    },
    {
      "type": "hayeon",
      "ko": "앞으로 많을거니까",
      "en": "a lot of surprises coming,"
    },
    {
      "type": "hayeon",
      "ko": "기대 많이해",
      "en": "so look forward to them."
    },
    {
      "type": "hayeon",
      "ko": "음 뭐",
      "en": "Well..."
    },
    {
      "type": "hayeon",
      "ko": "타이틀곡도 그렇고~",
      "en": "The title track, for one~"
    },
    {
      "type": "hayeon",
      "ko": "서울콘이나 뭐",
      "en": "The Seoul concert too,"
    },
    {
      "type": "hayeon",
      "ko": "여러가지로",
      "en": "and lots of other things."
    },
    {
      "type": "hayeon",
      "ko": "기대를 나눠서 하고있어바",
      "en": "Spread out your excitement and look forward to everything."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "fan",
      "ko": "하연이 이번 곡 파트가 제일 궁금해 다들 탐내던데",
      "en": "I'm most curious about your part in this song. Everyone seemed to want it."
    },
    {
      "type": "hayeon",
      "ko": "맞앜ㄹㅋㄹㅋㅋㄹ",
      "en": "Exactly. ㅋㄹㅋㄹㅋㅋㄹ"
    },
    {
      "type": "hayeon",
      "ko": "공개되면",
      "en": "Once it's released,"
    },
    {
      "type": "hayeon",
      "ko": "아~ 이래서 그랬구나",
      "en": "you'll go, 'Ah~ so that's why!'"
    },
    {
      "type": "hayeon",
      "ko": "그럴거야",
      "en": "You'll understand."
    },
    {
      "type": "hayeon",
      "ko": "스포임",
      "en": "That's your spoiler."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "빨리 활동하고싶당",
      "en": "I want promotions to start already."
    },
    {
      "type": "fan",
      "ko": "입이 근질근질해 막?",
      "en": "Is it making your mouth itch because you want to talk about it so badly?"
    },
    {
      "type": "hayeon",
      "ko": "어 막 여러가지로",
      "en": "Yeah, in so many ways."
    },
    {
      "type": "hayeon",
      "ko": "나만 알고있는게",
      "en": "Being the only one who knows"
    },
    {
      "type": "hayeon",
      "ko": "너무",
      "en": "just makes me"
    },
    {
      "type": "hayeon",
      "ko": "막 근질근질",
      "en": "so eager to spill everything."
    },
    {
      "type": "fan",
      "ko": "이러다 말실수 하면 웃기겟네",
      "en": "It'd be hilarious if you accidentally spoiled something."
    },
    {
      "type": "hayeon",
      "ko": "가사프랭크처럼",
      "en": "Like a lyrics prank,"
    },
    {
      "type": "hayeon",
      "ko": "여기다 가사 다써버리고",
      "en": "if I just wrote all the lyrics here,"
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "hayeon",
      "ko": "그러면 난 아주 망하겠지",
      "en": "I'd be completely doomed."
    },
    {
      "type": "fan",
      "ko": "난 아주 망하겠지 라는 가사가있나보군",
      "en": "So I guess there's a lyric that says 'I'd be completely doomed.'"
    },
    {
      "type": "hayeon",
      "ko": "좋은 시도였지만 저건 아무 의미가 없었다.",
      "en": "Nice try, but that meant absolutely nothing."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㄹㅋ",
      "en": "ㅋㄹㅋㄹㅋㄹㄹㅋ"
    },
    {
      "type": "fan",
      "ko": "하연아, 나 채원이야! 노래 가사를 깜빡했는데, 좀 알려줄 수 있어? 👉🏻👈🏻",
      "en": "HaYeon, it's ChaeWon! I forgot the lyrics. Can you remind me? 👉🏻👈🏻"
    },
    {
      "type": "hayeon",
      "ko": "채원아 그것도 까먹으면 어떡하지?",
      "en": "ChaeWon, how could you forget even that?"
    },
    {
      "type": "hayeon",
      "ko": "내가 내일 들려줄게",
      "en": "I'll tell you tomorrow."
    },
    {
      "type": "hayeon",
      "ko": "ㅎ",
      "en": "ㅎ"
    },
    {
      "type": "hayeon",
      "ko": "엄청난 스포는",
      "en": "Here's a huge spoiler:"
    },
    {
      "type": "hayeon",
      "ko": "라라라라라라라~",
      "en": "La la la la la la la~"
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "hayeon",
      "ko": "이번 활동",
      "en": "For this promotion,"
    },
    {
      "type": "hayeon",
      "ko": "일단 나는",
      "en": "I'm"
    },
    {
      "type": "hayeon",
      "ko": "엄청 기대중",
      "en": "really looking forward to it."
    },
    {
      "type": "hayeon",
      "ko": "걸네다를 이은",
      "en": "Following 'Girls Never Die,'"
    },
    {
      "type": "hayeon",
      "ko": "완전체",
      "en": "it's another full-group"
    },
    {
      "type": "hayeon",
      "ko": "노래 진짜",
      "en": "song that really"
    },
    {
      "type": "hayeon",
      "ko": "트리플에스",
      "en": "feels like"
    },
    {
      "type": "hayeon",
      "ko": "같아",
      "en": "tripleS."
    },
    {
      "type": "hayeon",
      "ko": "그자체",
      "en": "It's tripleS itself."
    },
    {
      "type": "fan",
      "ko": "수록곡들은 어때",
      "en": "What about the B-sides?"
    },
    {
      "type": "hayeon",
      "ko": "난 이번 수록곡들이",
      "en": "I think"
    },
    {
      "type": "hayeon",
      "ko": "진짜 좋은듯",
      "en": "the B-sides this time are really good."
    },
    {
      "type": "hayeon",
      "ko": "미안",
      "en": "Sorry."
    },
    {
      "type": "hayeon",
      "ko": "유빈언니",
      "en": "YuBin unnie"
    },
    {
      "type": "hayeon",
      "ko": "전화와서",
      "en": "just called me"
    },
    {
      "type": "hayeon",
      "ko": "언니방으로 오래",
      "en": "and told me to come to her room."
    },
    {
      "type": "hayeon",
      "ko": "심심하다거",
      "en": "She said she's bored."
    },
    {
      "type": "hayeon",
      "ko": "그치만 난 학교를 가야하기 때문에",
      "en": "But I have school tomorrow,"
    },
    {
      "type": "hayeon",
      "ko": "가지 않겠어.",
      "en": "so I'm not going."
    },
    {
      "type": "hayeon",
      "ko": "안갔엌ㅋㅎㅋㅎㅋㄹ",
      "en": "I didn't go. ㅋㅎㅋㅎㅋㄹ"
    },
    {
      "type": "hayeon",
      "ko": "공유반",
      "en": "GongYuBan."
    },
    {
      "type": "hayeon",
      "ko": "밤",
      "en": "At night,"
    },
    {
      "type": "hayeon",
      "ko": "날 너무 좋아하나봐",
      "en": "she must really like me."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "hayeon",
      "ko": "그녀의 제안을",
      "en": "I turned down"
    },
    {
      "type": "hayeon",
      "ko": "거절하고",
      "en": "her offer,"
    },
    {
      "type": "hayeon",
      "ko": "난 잠을 자겠당",
      "en": "and I'm going to sleep."
    },
    {
      "type": "hayeon",
      "ko": "나 잘게에",
      "en": "I'm heading to bed."
    },
    {
      "type": "hayeon",
      "ko": "잘자구",
      "en": "Sleep well,"
    },
    {
      "type": "hayeon",
      "ko": "감기 걸리지마!",
      "en": "and don't catch a cold!"
    },
    {
      "type": "hayeon",
      "ko": "하랑해😚",
      "en": "Haranghae. 😚"
    }
  ]
}