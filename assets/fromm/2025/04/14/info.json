    {
      "type": "hayeon",
      "ko": "차였는데",
      "en": "We were in a car,"
    },
    {
      "type": "hayeon",
      "ko": "아니",
      "en": "No."
    },
    {
      "type": "hayeon",
      "ko": "차였다는게 아니라",
