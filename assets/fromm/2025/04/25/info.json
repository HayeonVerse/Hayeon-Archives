    },
    {
      "type": "hayeon",
      "ko": "근데 생각보다 막 맛있지 않았어",
      "en": "But it wasn't as good as I expected."
    },
    {
      "type": "hayeon",
      "ko": "계란이 뭔가",
      "en": "The egg was"
    },
    {
      "type": "hayeon",
      "ko": "적절하지 못하게 익었고",
      "en": "cooked kind of awkwardly,"
    },
    {
      "type": "hayeon",
      "ko": "콩나물이 적었어",
      "en": "and there weren't enough bean sprouts."
    },
        {
      "type": "fan",
      "ko": "ㅋㅋㅋㅋㅋ 혼자 새벽에 먹으러 간 콩나물국밥보다는 별로였나보네 ㅋㅋㅋㅋㅋㅋㅋ",
      "en": "ㅋㅋㅋㅋㅋ I guess it wasn't as good as that bean sprout soup with rice you went out to eat by yourself in the middle of the night. ㅋㅋㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "헉 추억이다",
      "en": "Oh wow, that's a memory."
    },
    {
      "type": "hayeon",
      "ko": "근데 거긴 ㄹㅇ 맛집",
      "en": "But that place is seriously so good."
    },
    {
      "type": "hayeon",
      "ko": "휴게소가 따라올수 없어",
      "en": "No rest stop could ever compete with it."
    },
    {
      "type": "hayeon",
      "ko": "잠만",
      "en": "Hold on."
    },
    {
      "type": "hayeon",
      "ko": "미안",
      "en": "Sorry."
    },
    {
      "type": "hayeon",
      "ko": "잠만",
      "en": "Just a second."
    },
    {
      "type": "hayeon",
      "ko": "다녀옴!",
      "en": "I'm back!"
    },
    {
      "type": "hayeon",
      "ko": "헐 4분뒤",
      "en": "Whoa, only 4 minutes left."
    },
    {
      "type": "hayeon",
      "ko": "영상이네",
      "en": "Until the video comes out."
    },
    {
      "type": "hayeon",
      "ko": "3분뒤네",
      "en": "Actually, 3 minutes now."
    },
    {
      "type": "hayeon",
      "ko": "얼굴 좀 걱정되는뎈ㅎㅋㄹㅋㄹㅋㄹㅋ",
      "en": "I'm a little worried about how I look. ㅎㅋㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "너무 편하게 찍어서",
      "en": "We filmed it so casually."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "fan",
      "ko": "넌 생얼이어도 이뻐보여 괜찮아",
      "en": "You'll look pretty even without makeup, so don't worry."
    },
    {
      "type": "hayeon",
      "ko": "오",
      "en": "Oh."
    },
    {
      "type": "hayeon",
      "ko": "사랑이네",
      "en": "That's love."
    },
    {
      "type": "hayeon",
      "ko": "떳어??",
      "en": "Is it out now??"
    },
    {
      "type": "hayeon",
      "ko": "그럼나도 감상하러 갈게",
      "en": "Then I'm going to go watch it too."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㅋㄹㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㅋㄹㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "오늘 고생해써어~~ 나도 조심히 서울갈게!!",
      "en": "You worked hard today~~ I'll head back to Seoul safely too!!"
    },
    {
      "type": "hayeon",
      "ko": "잘자고 잘봥~~~🩷",
      "en": "Sleep well, and enjoy watching it~~~🩷"
    },
    {
      "type": "hayeon",
      "ko": "하랑해!!!🩷❤️",
