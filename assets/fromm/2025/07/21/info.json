    {
      "type": "hayeon",
      "ko": "사실 오늘 하려했는데",
      "en": "I was actually planning to do one today,"
    },
    {
      "type": "hayeon",
      "ko": "놀이공원의 여운이",
      "en": "but the amusement park"
    },
    {
      "type": "hayeon",
      "ko": "강하여…",
      "en": "really took it out of me..."
    },
    {
      "type": "hayeon",
      "ko": "뻗었습니다",
      "en": "I completely crashed."
    },
    {
      "type": "hayeon",
      "ko": "재밌게 논것도 논건데",
      "en": "It was really fun,"
    },
    {
      "type": "hayeon",
      "ko": "콘서트하고 바로 가자니",
      "en": "but going there right after the concert..."
    },
    {
      "type": "hayeon",
      "ko": "내 몸이",
      "en": "my body"
    },
    {
      "type": "hayeon",
      "ko": "어릴때 그 몸이 아니더라고",
      "en": "just isn't what it used to be when I was younger."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㅇㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㅇㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹ"
    },
    {
      "type": "hayeon",
      "ko": "이런다",
      "en": "Listen to me saying that."
    },
    {
      "type": "hayeon",
      "ko": "쨋든",
      "en": "Anyway,"
    },
    {
      "type": "hayeon",
      "ko": "힘들었음",
      "en": "I was exhausted."
    },
    {
      "type": "hayeon",
      "image": "image-01.PNG"
    },
    {
