},
{
  "type": "hayeon",
  "ko": "일단!!!",
  "en": "First!!!"
},
{
  "type": "hayeon",
  "ko": "고르고 올게",
  "en": "I'll go decide."
},
{
  "type": "hayeon",
  "ko": "시켜또",
  "en": "I ordered it."
},
{
  "type": "hayeon",
  "ko": "쌀국수",
  "en": "Pho."
},
{
  "type": "hayeon",
  "ko": "헤헤헤",
  "en": "Hehehe."
},
{
  "type": "hayeon",
  "ko": "안먹으면 예민해여 ㅎㅎㅎ",
  "en": "I get sensitive if I don't eat. ㅎㅎㅎ"
},
{
  "type": "hayeon",
  "ko": "아 그리고",
  "en": "Oh, and..."
},
{
  "type": "hayeon",
  "ko": "저번에",
  "en": "The other day,"
},
{
  "type": "hayeon",
  "ko": "핸드폰이 꺼졌는데",
  "en": "my phone died,"
},
{
  "type": "hayeon",
  "ko": "충전기도 말을 안듣고",
  "en": "and even the charger wouldn't work."
},
{
  "type": "hayeon",
  "ko": "핸드폰 없이살게 생긴거야",
  "en": "It looked like I'd have to live without my phone."
},
{
  "type": "hayeon",
  "ko": "늦은 밤이라",
  "en": "Since it was late at night,"
},
{
  "type": "hayeon",
  "ko": "누구거 빌리기도 애매하고",
  "en": "it felt awkward to borrow someone else's."
},
{
  "type": "hayeon",
  "ko": "근데 내가 요즘",
  "en": "But these days,"
},
{
  "type": "hayeon",
  "ko": "잠 들려면 기본 한시간 뒤척거리는데",
  "en": "I usually toss and turn for at least an hour before falling asleep."
},
{
  "type": "hayeon",
  "ko": "책을 봤더니",
  "en": "Then I started reading a book,"
},
{
  "type": "hayeon",
  "ko": "10분만에 졸린거야..",
  "en": "and I got sleepy within 10 minutes..."
},
{
  "type": "hayeon",
  "ko": "이게 좋은건지 안좋은건진 잘 모르겠지만 ㅎㅎ",
  "en": "I'm not sure if that's a good thing or not though. ㅎㅎ"
},
{
  "type": "hayeon",
  "ko": "암튼 그래서 그때부터",
  "en": "Anyway, ever since then,"
},
{
  "type": "hayeon",
  "ko": "자기 전에 책을 읽고있엉",
  "en": "I've been reading before going to bed."
},
{
  "type": "hayeon",
  "ko": "내가 읽는건",
  "en": "The book I'm reading..."
},
{
  "type": "hayeon",
  "ko": "Y/n한텐 좀 유치할수도 있는데",
  "en": "might feel a little childish to you, Y/n."
},
{
  "type": "hayeon",
  "ko": "어린아이가 살아가면서 얻는 깨달음들을 보여주고",
  "en": "It shows the lessons a young child learns while growing up,"
},
{
  "type": "hayeon",
  "ko": "그게 뭔가 지금 인생에도 도움이 되는것같아서",
  "en": "and somehow those lessons feel helpful even in my life now."
},
{
  "type": "hayeon",
  "ko": "보기 시작한건데",
  "en": "That's why I started reading it."
},
{
  "type": "hayeon",
  "ko": "잠만 혹시나 모르니까",
  "en": "Wait, just in case..."
},
{
  "type": "hayeon",
  "ko": "검색 좀 하고올게",
  "en": "Let me look it up first."
},
{
  "type": "hayeon",
  "ko": "꾸뻬씨의 인생여행",
  "en": "Hector and the Search for Happiness."
},
{
  "type": "hayeon",
  "ko": "이라는 책이야",
  "en": "That's the title."
},
{
  "type": "hayeon",
  "ko": "어린 아이가",
  "en": "A young child"
},
{
  "type": "hayeon",
  "ko": "어떤 일을 겪고나서",
  "en": "goes through different experiences,"
},
{
  "type": "hayeon",
  "ko": "아 이럴땐 이렇게 하는구나",
  "en": "and realizes, 'Oh, this is what you should do in a situation like this.'"
},
{
  "type": "hayeon",
  "ko": "이러면 안되는구나",
  "en": "'I shouldn't do that.'"
},
{
  "type": "hayeon",
  "ko": "이래야 하는구나",
  "en": "'I should do it this way.'"
},
{
  "type": "hayeon",
  "ko": "이런 깨달음을 얻으면서",
  "en": "While gaining those kinds of realizations,"
},
{
  "type": "hayeon",
  "ko": "일기에",
  "en": "they write in their diary,"
},
{
  "type": "hayeon",
