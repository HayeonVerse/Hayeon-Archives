},
{
  "type": "hayeon",
  "ko": "완전이지",
  "en": "Absolutely."
},
{
  "type": "fan",
  "ko": "가사 좀 써라 가사 좀 써라 정 프로듀서",
  "en": "Write some lyrics already, Producer Jeong!"
},
{
  "type": "hayeon",
  "ko": "아니 나 가끔 아무렇게나 생각나면",
