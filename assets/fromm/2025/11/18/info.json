{
  "date": "2025-11-18",
  "messages": [
    {
      "type": "hayeon",
      "ko": "모행",
      "en": "What are you doing?"
    },
    {
      "type": "hayeon",
      "ko": "난 스케줄 끝나구 학교~ ~ ~ ~",
      "en": "I finished my schedule and now I'm at school~~~~"
    },
    {
      "type": "fan",
      "ko": "이제 폰하다가 쌤한테 걸림",
      "en": "I just got caught by the teacher for using my phone."
    },
    {
      "type": "hayeon",
      "ko": "그걸 걸리네",
      "en": "You actually got caught?"
    },
    {
      "type": "fan",
      "ko": "교복셀카 기대해도 되는 부분..?",
      "en": "Can I look forward to a school uniform selfie...?"
    },
    {
      "type": "hayeon",
      "ko": "아쉽지만 학교갈때 교복을 안입어..",
      "en": "Sadly, I don't wear my school uniform when I go to school..."
    },
    {
      "type": "hayeon",
      "ko": "사복입즤",
      "en": "I wear my own clothes."
    },
    {
      "type": "hayeon",
      "ko": "그래 나 고3이야~ ~",
      "en": "That's right, I'm a third-year high school student~~"
    },
    {
      "type": "hayeon",
      "ko": "마장 어제 티저 나왔자나",
      "en": "Right, the teaser came out yesterday."
    },
    {
      "type": "hayeon",
      "ko": "어때!",
      "en": "What do you think!"
    },
    {
      "type": "hayeon",
      "ko": "찍는데 진짜 재밌었오",
      "en": "Filming it was really fun."
    },
    {
      "type": "fan",
      "ko": "잘생겨서 심장 아파...",
      "en": "You're so handsome that my heart hurts..."
    },
    {
      "type": "hayeon",
      "ko": "나오늘은 좀 잘생겼는데",
      "en": "I do look a bit handsome today."
    },
    {
      "type": "fan",
      "ko": "막 차 위에 타서 가더라",
      "en": "You were even riding on top of the car."
    },
    {
      "type": "fan",
      "ko": "ㄴㅁ재밌어보여서 나도 트리플에스 하고싶었음",
      "en": "It looked so fun that I wanted to be in tripleS too."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㅋㄹㅋ 그거도 재밌었어",
      "en": "ㅋㅋㅋㅋㅋㅋ That was fun too."
    },
    {
      "type": "hayeon",
      "ko": "보조배우분들이 뒤에서 따라오면서",
      "en": "The extras were following behind us."
    },
    {
      "type": "hayeon",
      "ko": "트리플에스다!! 여신이다!!!",
      "en": "\"It's tripleS!! It's a goddess!!!\""
    },
    {
      "type": "hayeon",
      "ko": "이러면서 따라오는데",
      "en": "They were following us while shouting that."
    },
    {
      "type": "hayeon",
      "ko": "너무 웃겼음",
      "en": "It was so funny."
    },
    {
      "type": "hayeon",
      "ko": "근데 외국분들도 많았는데",
      "en": "There were a lot of foreigners too."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㅋㄹㄹㅋ",
      "en": "ㅋㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "여싄이다!!",
      "en": "\"It's a goddeess!!\""
    },
    {
      "type": "hayeon",
      "ko": "재밌었어",
      "en": "It was fun."
    },
    {
      "type": "hayeon",
      "ko": "뮤비 진짜 이쁠것같음",
      "en": "I think the music video is going to look really pretty."
    },
    {
      "type": "hayeon",
      "ko": "아무래도 내가 찍었으니 그렇겠지",
      "en": "Well, I filmed it after all... so I guess it will."
    },
    {
      "type": "hayeon",
      "ko": "아니 내가 찍었다는게아니라…",
      "en": "No, I don't mean I filmed it..."
    },
    {
      "type": "hayeon",
      "ko": "그치 찍힌거지",
      "en": "Right, I mean I was the one being filmed."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㅋㄹㄹㅋ",
      "en": "ㅋㅋㅋㅋㅋㅋ"
    },
    {
      "type": "fan",
      "ko": "점심시간인데 밥은? 급식 묵어?",
      "en": "It's lunchtime. What did you eat? School lunch?"
    },
    {
      "type": "hayeon",
      "ko": "햄부기 목었여",
      "en": "I ate a hambugy."
    },
    {
      "type": "hayeon",
      "ko": "싸이버거",
      "en": "A Thigh Burger."
    },
    {
      "type": "hayeon",
      "ko": "잠을 못자서",
      "en": "Since I couldn't sleep..."
    },
    {
      "type": "hayeon",
      "ko": "일단 빨리 숙소를 가야할것같아",
      "en": "I think I need to hurry back to the dorm first."
    },
    {
      "type": "hayeon",
      "ko": "근데 아직도 모기가 있어?!?!?!",
      "en": "But... there are still mosquitoes?!?!?!"
    },
    {
      "type": "hayeon",
      "ko": "지금 3장 물렸어",
      "en": "I've already been bitten three times."
    },
    {
      "type": "hayeon",
      "ko": "내 피가 맛있나",
      "en": "Is my blood that tasty?"
    },
    {
      "type": "hayeon",
      "ko": "왤케 먹어",
      "en": "Why do they keep biting me?"
    },
    {
      "type": "hayeon",
      "ko": "발바닥에 물림",
      "en": "I even got bitten on the sole of my foot."
    },
    {
      "type": "hayeon",
      "ko": "벅벅 긁기에도 애매하고",
      "en": "It's such an awkward place to scratch."
    },
    {
      "type": "hayeon",
      "ko": "미치겠네",
      "en": "I'm going crazy."
    },
    {
      "type": "hayeon",
      "ko": "잠만",
      "en": "Hold on."
    },
    {
      "type": "hayeon",
      "ko": "가려움을 참고",
      "en": "I'll endure the itch..."
    },
    {
      "type": "hayeon",
      "ko": "쌤 보고올게",
      "en": "I'm going to see the teacher."
    },
    {
      "type": "hayeon",
      "ko": "(4분 뒤)",
      "en": "(4 minutes later)"
    },
    {
      "type": "hayeon",
      "ko": "아직 쌤이 안오셨어",
      "en": "The teacher still hasn't come."
    },
    {
      "type": "hayeon",
      "ko": "사이에 얘기하자",
      "en": "Let's chat while we wait."
    },
    {
      "type": "hayeon",
      "ko": "다행히도 벅벅긁고싶진 않아",
      "en": "Thankfully, I don't really feel like scratching it anymore."
    },
    {
      "type": "hayeon",
      "ko": "숙소가서 라이브킬까",
      "en": "Should I go live once I get back to the dorm?"
    },
    {
      "type": "fan",
      "ko": "잠 못 잤다며 자...",
      "en": "You said you couldn't sleep, so just sleep..."
    },
    {
      "type": "hayeon",
      "ko": "자면서 하는거지",
      "en": "I'll do it while sleeping."
    },
    {
      "type": "hayeon",
      "ko": "어때",
      "en": "How's that?"
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "같이 주무세요",
      "en": "Let's sleep together."
    },
    {
      "type": "hayeon",
      "ko": "잠꼬대 최초공개! 이런늠김",
      "en": "First-ever reveal of my sleep talking! Something like that."
    },
    {
      "type": "hayeon",
      "ko": "나 잘때 코 안고는데",
      "en": "I don't snore when I sleep."
    },
    {
      "type": "hayeon",
      "ko": "코 고는소리 잘내",
      "en": "But I'm really good at making snoring sounds."
    },
    {
      "type": "hayeon",
      "ko": "잠만 쌤오셤ㅅ다",
      "en": "Wait, the teacher's here."
    },
    {
      "type": "hayeon",
      "ko": "자맘ㄴ",
      "en": "Wait."
    },
    {
      "type": "hayeon",
      "ko": "(5분 뒤)",
      "en": "(5 minutes later)"
    },
    {
      "type": "hayeon",
      "ko": "나 지금 밀린 숙제중이야..",
      "en": "I'm catching up on overdue homework right now..."
    },
    {
      "type": "hayeon",
      "ko": "오랜만에 펜을 잡으니 기분이 묘하네",
      "en": "It feels strange holding a pen again after such a long time."
    },
    {
      "type": "hayeon",
      "ko": "나 그럼",
      "en": "Anyway..."
    },
    {
      "type": "hayeon",
      "ko": "숙소가서 라이브 킬수있음 킬겔",
      "en": "If I can go live once I get back to the dorm, I will."
    },
    {
      "type": "hayeon",
      "ko": "기다량",
      "en": "Wait for me~"
    },
    {
      "type": "hayeon",
      "ko": "빠이빠이",
      "en": "Bye-bye."
    }
  ]
}