    {
      "type": "hayeon",
      "ko": "내꺼니까",
      "en": "Because you're mine."
    },
    {
      "type": "hayeon",
      "ko": "나 소유욕도 질투심도 쎄",
      "en": "I'm really possessive and jealous too."
    },
    {
      "type": "fan",
      "ko": "귀하게 자란 닐 가지려 하다니 욕심이 많네",
      "en": "Trying to have someone who was raised so preciously... you're greedy."
    },
    {
      "type": "hayeon",
      "ko": "귀해서 더 가지고싶어",
      "en": "Because you're precious, I want you even more."
    },
    {
      "type": "hayeon",
      "ko": "하스라이팅 당해볼래?",
      "en": "Want to get 'Has-lighted'?"
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "맞다",
      "en": "Oh right."
    },
    {
      "type": "hayeon",
      "ko": "가스라이팅이 왜 가스라이팅인지 알아?",
      "en": "Do you know why it's called gaslighting?"
    },
    {
      "type": "hayeon",
      "ko": "옛날에",
      "en": "A long time ago..."
    },
    {
      "type": "hayeon",
      "ko": "어떤사람이",
      "en": "There was someone..."
    },
    {
      "type": "hayeon",
      "ko": "자꾸 집이 어두워지는것같고",
      "en": "Who kept feeling like their house was getting darker."
    },
    {
      "type": "hayeon",
      "ko": "잘 안보이는것같고",
      "en": "Like they couldn't see properly."
    },
    {
      "type": "hayeon",
      "ko": "그래서 친구한테",
      "en": "So they asked their friend..."
    },
    {
      "type": "hayeon",
      "ko": "어둡지않아? 안보이지않아? 하는데도",
      "en": "\"Isn't it dark? Can't you see?\""
    },
    {
      "type": "hayeon",
      "ko": "친구는 아니 잘보이는데? 너가 이상한거야",
      "en": "But the friend replied, \"No? I can see fine. You're the strange one.\""
    },
    {
      "type": "hayeon",
      "ko": "이런식으로 가스등을 계속 어둡게 어둡게 만들어서",
