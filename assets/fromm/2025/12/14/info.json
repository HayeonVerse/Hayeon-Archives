    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "살짝 그런거지",
      "en": "It's kind of like that."
    },
    {
      "type": "hayeon",
      "ko": "보기엔 시크하고 차갑고 멋진 언니느낌",
