    },
    {
      "type": "hayeon",
      "ko": "사실 자면서 감전 당했을수도",
      "en": "Actually, maybe I got electrocuted while I was sleeping."
    },
    {
      "type": "hayeon",
      "ko": "감전의 여파로",
      "en": "From the aftereffects of the shock,"
    },
    {
      "type": "hayeon",
      "ko": "기억을 잃고 다시 잠든거지",
      "en": "I lost my memory and just fell asleep again."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㄹ",
      "en": "ㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "사진",
      "image": "image-01.webp"
    },
    {
      "type": "fan",
      "ko": "요즘 너무 에겐에겐하다..",
