    {
      "type": "hayeon",
      "ko": "충전기가 꽃힌 상태로 부러진거야",
      "en": "The charging cable had snapped while it was still plugged in."
    },
    {
      "type": "hayeon",
      "ko": "내가 잘때 부러뜨렸나",
      "en": "Maybe I broke it while I was sleeping."
    },
    {
      "type": "hayeon",
      "ko": "보조배터리 충전 입구에",
      "en": "In the charging port of the power bank,"
    },
    {
      "type": "hayeon",
      "ko": "뭔가가 있길래 봤는데",
      "en": "there was something stuck inside, so I looked..."
