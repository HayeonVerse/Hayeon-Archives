    {
      "type": "hayeon",
      "ko": "많이 이뻐볼게",
      "en": "I'll try to look really pretty."
    },
    {
      "type": "hayeon",
      "ko": "자랑스럽게~",
      "en": "So you can be proud~"
    },
    {
      "type": "fan",
      "ko": "넌 항상 자랑스러와",
      "en": "I'm always proud of you."
    },
    {
