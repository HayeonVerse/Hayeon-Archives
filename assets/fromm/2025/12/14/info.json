    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㅋㅎㅋ",
      "en": "ㅋㅋㅋㅋㅋ"
    },
    {
      "type": "hayeon",
      "ko": "어 ㅋㅋ",
      "en": "Oh, haha."
    },
    {
      "type": "hayeon",
      "ko": "사랑해",
      "en": "I love you."
    },
    {
      "type": "fan",
