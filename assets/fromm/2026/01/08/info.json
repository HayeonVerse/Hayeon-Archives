    },
    {
      "type": "hayeon",
      "ko": "에헤헤",
      "en": "에헤헤."
    },
    {
      "type": "hayeon",
      "ko": "아",
      "en": "Ah."
    },
    {
      "type": "hayeon",
      "ko": "이썰",
      "en": "I want to tell you this story."
    },
    {
      "type": "hayeon",
      "ko": "풀고싶다",
      "en": "I've been wanting to share it."
    },
    {
      "type": "hayeon",
      "ko": "전에",
      "en": "Before..."
    },
    {
      "type": "hayeon",
      "ko": "어떤 분이",
      "en": "Someone asked me,"
    },
    {
      "type": "hayeon",
      "ko": "성인이세요~?",
