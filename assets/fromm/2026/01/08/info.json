    {
      "type": "hayeon",
      "ko": "착각하심",
      "en": "They misunderstood."
    },
    {
      "type": "hayeon",
      "ko": "미자님?",
      "en": "\"Ms. Mija?\""
    },
    {
      "type": "hayeon",
      "ko": "이러셔서",
      "en": "They said."
    },
    {
      "type": "hayeon",
      "ko": "ㅋㄹㅋㄹㅋㄹㄹㅋㄹㅋㄹㅋ",
      "en": "ㅋㄹㅋㄹㅋㄹㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "아뇨..미성년자…",
      "en": "\"No... I meant a minor...\""
    },
    {
      "type": "hayeon",
      "ko": "ㅋㅎㅋㄹㄹㅋㅎㅋㅋ",
      "en": "ㅋㅎㅋㄹㄹㅋㅎㅋㅋ"
    },
    {
      "type": "fan",
      "ko": "네 미자님 그래서 성인이실까요?",
