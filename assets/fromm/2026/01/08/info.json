    },
    {
      "type": "hayeon",
      "ko": "ㄹㅋㄹㅋㄹㅋ",
      "en": "ㄹㅋㄹㅋㄹㅋ"
    },
    {
      "type": "hayeon",
      "ko": "자주먹는게 있어",
      "en": "There's something I eat all the time."
    },
    {
      "type": "hayeon",
      "ko": "진짜 너무 사랑해",
      "en": "I seriously love it so much."
    },
    {
      "type": "hayeon",
      "ko": "열무 비빔밥",
      "en": "Young radish bibimbap."
    },
    {
      "type": "hayeon",
      "ko": "후라이2개추가",
      "en": "With two extra fried eggs."
    },
    {
      "type": "hayeon",
      "ko": "진짜 미치겠음",
      "en": "It's seriously driving me crazy."
    },
    {
      "type": "hayeon",
      "ko": "청국장 같이 시켜서",
      "en": "Order cheonggukjang too."
    },
    {
      "type": "hayeon",
      "ko": "같이 비벼서",
      "en": "Mix it all together."
