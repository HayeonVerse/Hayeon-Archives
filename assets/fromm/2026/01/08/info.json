    {
      "type": "hayeon",
      "ko": "워터파크",
      "en": "A water park."
    },
    {
      "type": "hayeon",
      "ko": "놀이공원",
      "en": "An amusement park."
    },
    {
      "type": "hayeon",
      "ko": "머 이런것",
      "en": "Stuff like that."
    },
    {
      "type": "fan",
      "ko": "키자니아",
      "en": "KidZania."
    },
    {
      "type": "hayeon",
      "ko": "와 나 키자니아 사랑함",
      "en": "Wow, I love KidZania."
    },
    {
      "type": "hayeon",
      "ko": "이거에 대한 썰이 있는데",
      "en": "I actually have a story about it."
    },
    {
      "type": "hayeon",
      "ko": "내가 어릴때 부모님이랑 키자니아를 갔어",
      "en": "When I was little, I went there with my parents."
    },
    {
      "type": "hayeon",
      "ko": "거기 쇼호스트라는 직업이 있었는데",
