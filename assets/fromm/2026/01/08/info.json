    },
    {
      "type": "hayeon",
      "ko": "나랑 또 다른 한명이 나와서 진행을 막 하고 옷 설명이랑 테마 설명을 하면",
      "en": "Another kid and I hosted it, explaining the clothes and the theme."
    },
    {
      "type": "hayeon",
      "ko": "모델직업 선택한 친구들이",
      "en": "The kids who picked the model job..."
    },
    {
      "type": "hayeon",
      "ko": "무대 나와서 워킹하고",
      "en": "would come out, do a runway walk..."
    },
    {
      "type": "hayeon",
      "ko": "들어가는",
      "en": "and then go backstage."
    },
    {
      "type": "hayeon",
      "ko": "근데 거기 프롬이 있었는데",
      "en": "There was a prompter there."
    },
    {
      "type": "hayeon",
      "ko": "본 무대때",
      "en": "During the main show..."
    },
    {
      "type": "hayeon",
      "ko": "옆에",
      "en": "The kid next to me..."
    },
    {
      "type": "hayeon",
      "ko": "같이 엠씨하는애가",
      "en": "who was MCing with me..."
    },
    {
      "type": "hayeon",
      "ko": "프롬도 안보고 가만히 있는거야",
      "en": "was just standing there without looking at the prompter."
