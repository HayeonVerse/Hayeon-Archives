    {
      "type": "hayeon",
      "ko": "누구 맘대로~~",
      "en": "Says who~~"
    },
    {
      "type": "hayeon",
      "ko": "자기 졸업식 와달라고 졸랐었는데",
      "en": "She begged me to come to her graduation."
    },
    {
      "type": "hayeon",
      "ko": "한림즈가 갔어유",
      "en": "But Hanlimz went instead."
    },
    {
      "type": "hayeon",
      "ko": "전 그럼 리라즈 부를게요",
      "en": "Then I'll invite Lilaz."
    },
    {
      "type": "hayeon",
      "ko": "음~",
      "en": "Hmm~"
    },
    {
      "type": "hayeon",
      "ko": "혼자네 ㅎ",
      "en": "I'm alone, ㅎ."
    },
    {
      "type": "hayeon",
      "ko": "슬프구만",
      "en": "That's kind of sad."
    },
    {
      "type": "hayeon",
      "ko": "나도",
      "en": "Me too..."
    },
    {
      "type": "hayeon",
      "ko": "스키장 데려가!!!",
      "en": "Take me to the ski resort!!!"
    },
    {
      "type": "hayeon",
      "ko": "그럼 안한림즈는 뭐 안주나요",
