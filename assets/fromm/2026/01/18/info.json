    {
      "type": "hayeon",
      "ko": "꼬치집을 간거야",
      "en": "It was a skewer restaurant."
    },
    {
      "type": "hayeon",
      "ko": "첨엔 신기한것들 많이 나와서",
      "en": "At first, a lot of interesting things came out,"
    },
    {
      "type": "hayeon",
      "ko": "막 신나게 먹었는데",
      "en": "so I happily ate everything."
    },
    {
      "type": "hayeon",
      "ko": "점점 끝도없이 나오는거야",
      "en": "Then they just kept bringing out more and more without end."
    },
    {
      "type": "hayeon",
      "ko": "매니저님이 직원분한테",
      "en": "Our manager even told the staff,"
    },
    {
      "type": "hayeon",
      "ko": "플리즈!!!제발 그만주세요 ㅠㅠㅠ",
      "en": "\"Please!!! Seriously, please stopㅠㅠㅠ\""
    },
    {
      "type": "hayeon",
      "ko": "이럴때까지 영원히 나옴",
