{
  "date": "2026-01-18",
  "messages": [
    {
      "type": "hayeon",
      "ko": "뭐해ㅐ",
      "en": "What are you doing~"
    },
    {
      "type": "hayeon",
      "ko": "상하이 잘 다녀왔어ㅓ",
      "en": "I got back from Shanghai safely."
    },
    {
      "type": "hayeon",
      "ko": "너무 좋았어",
      "en": "It was so good."
    },
    {
      "type": "hayeon",
      "ko": "오랜만에 해외 스케줄 하니까",
      "en": "Since it was my first overseas schedule in a while,"
    },
    {
      "type": "hayeon",
      "ko": "뭔가 투어깨로 돌아간것도 같고",
      "en": "it kind of felt like we were back on tour again."
    },
    {
      "type": "hayeon",
      "ko": "반가웠자나",
      "en": "It felt so familiar."
    },
    {
      "type": "hayeon",
      "ko": "룸메도 김채원이라서 투어같았어 ㅋㅋㅋㅋ",
      "en": "And since my roommate was Kim Chaewon again, it really felt like we were on tourㅋㅋㅋㅋ"
    },
    {
      "type": "fan",
      "ko": "무한 꼬치 폭격 받았다며",
      "en": "I heard you got bombarded by endless skewers."
    },
    {
      "type": "hayeon",
      "ko": "와 맞아",
      "en": "Wow, that's right."
    },
    {
      "type": "hayeon",
      "ko": "팬미팅 끝나고 식당을 갔는데",
