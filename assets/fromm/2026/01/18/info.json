    },
    {
      "type": "hayeon",
      "ko": "이건 뭐지~ ~ ~!!?하고",
      "en": "\"What is this~ ~ ~!!?\" she said,"
    },
    {
      "type": "hayeon",
      "ko": "신나게 먹었는데",
      "en": "and happily ate it."
    },
    {
