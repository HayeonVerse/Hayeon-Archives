    {
      "type": "hayeon",
      "ko": "맛있더라",
      "en": "was really good."
    },
    {
      "type": "hayeon",
      "ko": "고기가",
      "en": "The meat"
    },
    {
      "type": "hayeon",
      "ko": "너무 부드러우ㅜ",
      "en": "was so tenderㅜ"
    },
    {
      "type": "hayeon",
      "ko": "오늘도 체력이 잘 버텨주길…..",
      "en": "I hope my stamina holds up well again today….."
    },
    {
      "type": "hayeon",
      "ko": "화이팅이양",
      "en": "Fighting~"
    },
    {
      "type": "hayeon",
      "ko": "그럼 마저준비하러 갈게",
      "en": "Then I'll go finish getting ready."
