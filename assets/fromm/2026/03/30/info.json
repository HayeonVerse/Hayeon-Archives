},
{
  "type": "hayeon",
  "ko": "응 ㅎㅎ",
  "en": "Yeah. ㅎㅎ"
},
{
  "type": "hayeon",
  "ko": "나만 날 고른거지",
  "en": "I was the only one who voted for myself."
},
{
  "type": "hayeon",
  "ko": "나오자마자 그친구를 바라보았는데",
