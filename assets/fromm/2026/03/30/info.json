},
{
  "type": "hayeon",
  "ko": "그것이 아니였다면",
  "en": "If I hadn't done that,"
},
{
  "type": "hayeon",
  "ko": "빵표로 고통받았을 제",
  "en": "I would've had to suffer from getting zero votes."
},
{
  "type": "hayeon",
  "ko": "자신을 생각하니",
  "en": "Thinking about my past self,"
},
{
  "type": "hayeon",
  "ko": "마음이 너무 아프네오",
  "en": "my heart hurts so much."
},
{
  "type": "hayeon",
  "ko": "하지만 그친구를 용서합니다",
  "en": "But I forgive that friend."
},
{
  "type": "hayeon",
  "ko": "저도 그친구에게",
  "en": "Because I also"
},
{
  "type": "hayeon",
